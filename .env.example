# Copy to .env and fill in values.
# Variables here are available locally in MiniOxygen.
# Set the same names as Oxygen environment variables for production (redeploy after changes).

SESSION_SECRET="foobar"

# BILDIT — same names as the Next.js integration guide
# BILDIT_API_URL: VXE host you log into (not this Hydrogen storefront URL)
#   admin-dev.bildit.co | admin-staging.bildit.co | admin.bildit.co
BILDIT_API_URL="https://admin-dev.bildit.co"
BILDIT_API_KEY=""
